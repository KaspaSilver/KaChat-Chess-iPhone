
// KaChat Chess's version and build number, one place for the whole app. Raise
// CURRENT_PROJECT_VERSION by 1 before every upload: App Store Connect wants each build of a
// marketing version numbered above the last.
KACHAT_BUILD_NUMBER = $(CURRENT_PROJECT_VERSION)
KACHAT_IS_RELEASE = NO
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0

// Required for `agvtool` to write CURRENT_PROJECT_VERSION.
VERSIONING_SYSTEM = apple-generic
