<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kachat.chess</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kachatchess</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KaChatBuildNumber</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<key>KaChatIsRelease</key>
	<string>$(KACHAT_IS_RELEASE)</string>
	<key>NSCameraUsageDescription</key>
	<string>KaPlay uses the camera to scan a Kaspa address QR code when you send KAS.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock your seed phrase and sign back in, when enabled in Settings.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KaPlay connects to a Kaspa node on your local network only if you set one up in Settings &gt; Connection.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
